{
  "name": "trading-journal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "fetch:vnindex": "python scripts/fetch_vnindex.py",
    "import:bars": "npx tsx scripts/import-bars.ts",
    "data:vnindex": "python scripts/fetch_vnindex.py && npx tsx scripts/import-bars.ts",
    "ops:assert-prod-db": "npx tsx scripts/assert-production-database.ts",
    "ops:export-active-symbols": "npx tsx scripts/export-active-symbol-keys.ts",
    "ops:verify-bar-import": "npx tsx scripts/verify-bar-import-health.ts",
    "ops:expected-session-day": "npx tsx scripts/print-expected-session-day.ts",
    "fetch:foreign": "python scripts/fetch_foreign_snapshot.py",
    "import:foreign": "npx tsx scripts/import-foreign-flow.ts",
    "build:market-context": "npx tsx scripts/build-market-context.ts",
    "ops:verify-market-context": "npx tsx scripts/verify-market-context-health.ts",
    "ops:monitor-market-context": "npx tsx scripts/monitor-market-context-sessions.ts",
    "data:market-context": "npx tsx scripts/import-foreign-flow.ts && npx tsx scripts/build-market-context.ts",
    "gate1:print": "npx tsx scripts/print-gate1-regime.ts",
    "gate1:check": "npx tsx scripts/print-gate1-regime.ts",
    "scanner:near-miss": "npx tsx scripts/scanner-near-miss.ts",
    "verify:market-data": "npx tsx scripts/verify-market-data.ts",
    "audit:early-entry:paper-log": "npx tsx scripts/audit/early-entry-paper-log.ts",
    "audit:early-entry:paper-log:seed": "npx tsx scripts/audit/early-entry-paper-log.ts --seed-historical",
    "audit:early-entry:paper-validate": "npx tsx scripts/audit/early-entry-paper-validation.ts",
    "audit:early-entry:paper-summary": "npx tsx scripts/audit/early-entry-paper-summary.ts",
    "ops:vercel:enable-early-entry": "bash scripts/ops/enable-early-entry-vercel.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.1",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^7.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
