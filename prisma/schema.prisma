generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trades Trade[]

  @@map("users")
}

model Trade {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  setupId   String?     @map("setup_id")
  symbol    String
  direction Direction
  status    TradeStatus @default(PLANNED)

  entryDate DateTime  @map("entry_date")
  exitDate  DateTime? @map("exit_date")

  entryPrice Float  @map("entry_price")
  exitPrice  Float? @map("exit_price")
  quantity   Float
  fees       Float  @default(0)

  realizedPnl Float?        @map("realized_pnl")
  rMultiple   Float?        @map("r_multiple")
  outcome     TradeOutcome?

  /// Locked product playbook — only `BREAKOUT_PULLBACK` is supported.
  playbook Playbook @default(BREAKOUT_PULLBACK) @map("playbook")

  entryReason         TradeEntryReason?         @map("entry_reason")
  entryLocationVsZone TradeEntryLocationVsZone? @map("entry_location_vs_zone")
  healthLevelAtEntry  SetupHealthLevel?         @map("health_level_at_entry")
  healthScoreAtEntry  Int?                      @map("health_score_at_entry")
  stopLoss            Float?                    @map("stop_loss")
  takeProfit          Float?                    @map("take_profit")
  positionSize        Float?                    @map("position_size")
  setupSnapshot       Json?                     @map("setup_snapshot")
  exitReason          TradeExitReason?          @map("exit_reason")
  exitDiscipline      TradeExitDiscipline?      @map("exit_discipline")
  entryNote           String?                   @map("entry_note") @db.Text
  exitNote            String?                   @map("exit_note") @db.Text

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  setupCandidate SetupCandidate?  @relation(fields: [setupId], references: [id], onDelete: SetNull)
  setupOutcomes  SetupOutcome[]
  healthLogs     TradeHealthLog[]

  @@index([userId])
  @@index([setupId])
  @@index([symbol])
  @@index([status])
  @@index([entryDate])
  @@map("trades")
}

/// Per-trade EOD health checkpoints (append-only). Table created in migration 20260506120000.
model TradeHealthLog {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tradeId           String           @map("trade_id")
  trade             Trade            @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  checkedAt         DateTime         @default(now()) @map("checked_at")
  healthLevel       SetupHealthLevel @map("health_level")
  healthScore       Int?             @map("health_score")
  priceVsZone       String?          @map("price_vs_zone")
  structureStatus   String?          @map("structure_status")
  recommendedAction String?          @map("recommended_action")
  reviewChecklist   Json?            @map("review_checklist")

  @@index([tradeId, checkedAt])
  @@map("trade_health_logs")
}

enum Direction {
  LONG
  SHORT
}

enum TradeStatus {
  PLANNED
  OPEN
  CLOSED
  CANCELLED
}

enum Playbook {
  BREAKOUT_PULLBACK
}

enum DailyScanRunStatus {
  COMPLETED
  FAILED
}

enum Gate1ScanLevel {
  PASS
  WARNING
  FAIL
}

enum ScanSetupType {
  BREAKOUT_PULLBACK
}

enum ScanQuality {
  A
  B
}

enum SetupLifecycleStatus {
  NEW
  WATCHING
  READY
  TRIGGERED
  EXPIRED
  INVALID
}

enum SetupHealthLevel {
  HEALTHY
  WARNING
  AT_RISK
  DEAD
}

enum TacticalSymbolStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum TradeEntryReason {
  ZONE_RETEST
  BREAKOUT_CONFIRM
  PULLBACK_ENTRY
  STRUCTURE_CONTINUATION
  MOMENTUM_CONFIRM
  READY_ON_OPEN
  READY_INTRADAY
  LATE_CHASE
}

enum TradeExitReason {
  TAKE_PROFIT_HIT
  STOP_LOSS_HIT
  ZONE_INVALIDATED
  STRUCTURE_BROKEN
  HEALTH_DEGRADED_EOD
  TIME_STOP
  MANUAL_RULE_BASED_EXIT
}

enum TradeExitDiscipline {
  FOLLOWED_PLAN
  EARLY_EXIT_RULE_BASED
  EMOTIONAL_EXIT
  RULE_VIOLATION
}

enum TradeEntryLocationVsZone {
  IN_ZONE
  ABOVE_ZONE
  BELOW_ZONE
}

enum TradeOutcome {
  WIN
  LOSS
  BREAKEVEN
}

enum ForeignCaptureMethod {
  PRICE_BOARD_EOD_SNAPSHOT
}

enum ForeignDataQuality {
  OK
  ALL_ZERO
  PARTIAL
  ERROR
}

model IndexDailyBar {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String   @default("vnstock:VCI")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, date])
  @@index([symbol])
  @@map("index_daily_bars")
}

/// Equity symbols for multi-symbol EOD data (scanner / tradability).
model StockSymbol {
  id        String   @id @default(cuid())
  symbol    String   @unique
  exchange  String?
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bars                 StockDailyBar[]
  setupCandidates      SetupCandidate[]
  setupWatchItems      SetupWatchItem[]
  foreignTradeDaily    ForeignTradeDaily[]
  symbolMarketContexts SymbolMarketContextDaily[]

  @@map("stock_symbols")
}

/// Additive tactical symbol intake used by effective universe merge (core ∪ tactical).
model TacticalSymbol {
  id               String               @id @default(cuid())
  symbol           String
  source           String
  reasonNote       String?              @map("reason_note") @db.Text
  activeForScanner Boolean              @default(true) @map("active_for_scanner")
  status           TacticalSymbolStatus @default(ACTIVE)
  expiresAt        DateTime             @map("expires_at")
  importedBarsAt   DateTime?            @map("imported_bars_at")
  lastEvaluatedAt  DateTime?            @map("last_evaluated_at")
  addedBy          String?              @map("added_by")
  addedAt          DateTime             @default(now()) @map("added_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([symbol, status])
  @@index([symbol])
  @@index([status])
  @@index([activeForScanner])
  @@index([expiresAt])
  @@index([status, activeForScanner, expiresAt])
  @@map("tactical_symbols")
}

model StockDailyBar {
  id        String      @id @default(cuid())
  symbolId  String      @map("symbol_id")
  symbol    StockSymbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String      @default("vnstock:VCI")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([symbolId, date])
  @@index([symbolId, date(sort: Desc)])
  @@map("stock_daily_bars")
}

/// Forward-only VCI price_board EOD foreign snapshot (session-cumulative).
model ForeignTradeDaily {
  id            String               @id @default(cuid())
  symbolId      String               @map("symbol_id")
  symbol        StockSymbol          @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  sessionDate   DateTime             @db.Date @map("session_date")

  buyVolume     Float?               @map("buy_volume")
  sellVolume    Float?               @map("sell_volume")
  netVolume     Float?               @map("net_volume")

  buyValueVnd   Float?               @map("buy_value_vnd")
  sellValueVnd  Float?               @map("sell_value_vnd")
  netValueVnd   Float?               @map("net_value_vnd")

  source        String               @default("vnstock:VCI")
  captureMethod ForeignCaptureMethod @default(PRICE_BOARD_EOD_SNAPSHOT) @map("capture_method")
  capturedAt    DateTime             @default(now()) @map("captured_at")
  dataQuality   ForeignDataQuality   @default(PARTIAL) @map("data_quality")

  @@unique([symbolId, sessionDate])
  @@index([sessionDate])
  @@index([symbolId, sessionDate(sort: Desc)])
  @@map("foreign_trade_daily")
}

model MarketContextDaily {
  sessionDate         DateTime        @id @db.Date @map("session_date")

  vnindexClose        Float?          @map("vnindex_close")
  vnindexMa20         Float?          @map("vnindex_ma20")
  vnindexMa50         Float?          @map("vnindex_ma50")
  vnindexVolume       Float?          @map("vnindex_volume")
  vnindexVolMa20      Float?          @map("vnindex_vol_ma20")
  vnindexVolRatioMa20 Float?          @map("vnindex_vol_ratio_ma20")

  gate1Level          Gate1ScanLevel? @map("gate1_level")

  foreignNetValue1d   Float?          @map("foreign_net_value_1d")
  foreignNetValue5d   Float?          @map("foreign_net_value_5d")
  foreignNetValue10d  Float?          @map("foreign_net_value_10d")

  foreignSymbolsOk    Int             @default(0) @map("foreign_symbols_ok")
  foreignSymbolsTotal Int             @default(0) @map("foreign_symbols_total")
  foreignCoveragePct  Float?          @map("foreign_coverage_pct")

  symbolsBuilt        Int             @default(0) @map("symbols_built")
  builtAt             DateTime        @default(now()) @map("built_at")

  symbolContexts SymbolMarketContextDaily[]

  @@map("market_context_daily")
}

model SymbolMarketContextDaily {
  id                 String              @id @default(cuid())
  sessionDate        DateTime            @db.Date @map("session_date")
  symbolId           String              @map("symbol_id")
  symbol             StockSymbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  marketContext      MarketContextDaily  @relation(fields: [sessionDate], references: [sessionDate], onDelete: Cascade)

  close              Float?
  volume             Float?
  volMa20            Float?              @map("vol_ma20")
  volRatioMa20       Float?              @map("vol_ratio_ma20")

  foreignNetValue1d  Float?              @map("foreign_net_value_1d")
  foreignNetValue5d  Float?              @map("foreign_net_value_5d")
  foreignNetValue10d Float?              @map("foreign_net_value_10d")
  foreignDataQuality ForeignDataQuality? @map("foreign_data_quality")

  @@unique([sessionDate, symbolId])
  @@index([symbolId, sessionDate(sort: Desc)])
  @@map("symbol_market_context_daily")
}

model DailyScanRun {
  id                          String             @id @default(cuid())
  runAt                       DateTime           @default(now()) @map("run_at")
  startedAt                   DateTime?          @map("started_at")
  finishedAt                  DateTime?          @map("finished_at")
  gate1Level                  Gate1ScanLevel     @map("gate1_level")
  status                      DailyScanRunStatus
  symbolCountTotal            Int                @map("symbol_count_total")
  symbolCountScanned          Int                @default(0) @map("symbol_count_scanned")
  symbolCountFailed           Int                @default(0) @map("symbol_count_failed")
  symbolCountAfterTradability Int                @map("symbol_count_after_tradability")
  symbolCountFilteredOut      Int                @map("symbol_count_filtered_out")
  candidateCountA             Int                @map("candidate_count_a")
  candidateCountB             Int                @map("candidate_count_b")
  candidateCountSurfaced      Int                @map("candidate_count_surfaced")
  setupCandidatesCreated      Int                @default(0) @map("setup_candidates_created")
  tradabilityBreakdown        Json?              @map("tradability_breakdown")
  /// Optional Gate 2 rejection diagnostics when surfacing 0 candidates (JSON).
  notes                       Json?              @map("notes")
  errorSummary                String?            @map("error_summary") @db.Text

  candidates SetupCandidate[]

  @@index([runAt(sort: Desc)])
  @@map("daily_scan_runs")
}

model SetupCandidate {
  id               String        @id @default(cuid())
  scanRunId        String        @map("scan_run_id")
  scanRun          DailyScanRun  @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  symbolId         String        @map("symbol_id")
  symbol           StockSymbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  setupType        ScanSetupType @map("setup_type")
  quality          ScanQuality
  close            Float
  breakoutLevel    Float         @map("breakout_level")
  pullbackZoneLow  Float         @map("pullback_zone_low")
  pullbackZoneHigh Float         @map("pullback_zone_high")
  stopLevel        Float         @map("stop_level")
  reasons          Json
  rankScore        Float         @map("rank_score")
  barDate          DateTime      @map("bar_date") @db.Date

  trades   Trade[]
  outcomes SetupOutcome[]

  @@index([scanRunId])
  @@index([symbolId])
  @@map("setup_candidates")
}

model SetupOutcome {
  id                  String                    @id @default(cuid())
  setupId             String                    @map("setup_id")
  setup               SetupCandidate            @relation(fields: [setupId], references: [id], onDelete: Cascade)
  tradeId             String                    @unique @map("trade_id")
  trade               Trade                     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  setupType           ScanSetupType             @map("setup_type")
  setupTierAtEntry    ScanQuality               @map("setup_tier_at_entry")
  entryReason         TradeEntryReason?         @map("entry_reason")
  entryLocationVsZone TradeEntryLocationVsZone? @map("entry_location_vs_zone")
  healthLevelAtEntry  SetupHealthLevel?         @map("health_level_at_entry")
  healthLevelAtExit   SetupHealthLevel?         @map("health_level_at_exit")
  exitReason          TradeExitReason?          @map("exit_reason")
  exitDiscipline      TradeExitDiscipline?      @map("exit_discipline")
  rMultiple           Float?                    @map("r_multiple")
  pnl                 Float?                    @map("pnl")
  outcome             TradeOutcome?
  createdAt           DateTime                  @default(now()) @map("created_at")

  @@index([setupId])
  @@index([setupType, setupTierAtEntry])
  @@map("setup_outcomes")
}

/// Durable watch row for scanner setups — health overlay only in this phase (no lifecycle FSM).
model SetupWatchItem {
  id        String        @id @default(cuid())
  symbolId  String        @map("symbol_id")
  symbol    StockSymbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  setupType ScanSetupType @map("setup_type")
  quality   ScanQuality

  lifecycleStatus SetupLifecycleStatus @default(WATCHING) @map("lifecycle_status")

  breakoutLevel    Float @map("breakout_level")
  pullbackZoneLow  Float @map("pullback_zone_low")
  pullbackZoneHigh Float @map("pullback_zone_high")

  firstSeenBarDate  DateTime @map("first_seen_bar_date") @db.Date
  lastSeenScanRunId String?  @map("last_seen_scan_run_id")

  healthFlags           Json?             @map("health_flags")
  healthScore           Int?              @map("health_score")
  healthLevel           SetupHealthLevel? @map("health_level")
  lastHealthEvaluatedAt DateTime?         @map("last_health_evaluated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([symbolId, setupType])
  @@index([healthLevel])
  @@index([lifecycleStatus])
  @@map("setup_watch_items")
}

/// Daily RS near-miss watchlist scoring snapshot (diagnostic lane — not trade signals).
model RsWatchlistSnapshotRun {
  id                      String                   @id @default(cuid())
  sessionDate             DateTime                 @map("session_date") @db.Date
  createdAt               DateTime                 @default(now()) @map("created_at")
  verdictUxLevel          String?                  @map("verdict_ux_level")
  tradePermission         String?                  @map("trade_permission")
  tradabilityPassedCount  Int?                     @map("tradability_passed_count")
  scoringVersion          String                   @default("v0") @map("scoring_version")
  rows                    RsWatchlistSnapshotRow[]

  @@unique([sessionDate])
  @@index([sessionDate(sort: Desc)])
  @@map("rs_watchlist_snapshot_runs")
}

model RsWatchlistSnapshotRow {
  id                         String               @id @default(cuid())
  runId                      String               @map("run_id")
  run                        RsWatchlistSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rankPosition               Int                  @map("rank_position")
  symbol                     String
  rs20SpreadPct              Float                @map("rs20_spread_pct")
  rs50SpreadPct              Float?               @map("rs50_spread_pct")
  terminalCode               String?              @map("terminal_code")
  setupState                 String               @map("setup_state")
  setupReason                String               @map("setup_reason") @db.Text
  stageRank                  Int?                 @map("stage_rank")
  distanceToPullbackZoneFrac Float?               @map("distance_to_pullback_zone_frac")
  rsStrengthScore            Int?                 @map("rs_strength_score")
  setupReadinessScore        Int?                 @map("setup_readiness_score")
  rsConfidence               String?              @map("rs_confidence")
  forwardReturn3dPct         Float?               @map("forward_return_3d_pct")
  forwardReturn5dPct         Float?               @map("forward_return_5d_pct")
  forwardReturn10dPct        Float?               @map("forward_return_10d_pct")
  maxDrawdown10dPct          Float?               @map("max_drawdown_10d_pct")

  @@index([runId, rankPosition])
  @@index([symbol])
  @@map("rs_watchlist_snapshot_rows")
}

// ─── Paper Trading Lab (AI Arena) ───

enum PaperPortfolioStatus {
  ACTIVE
  ARCHIVED
}

enum PaperOrderSide {
  BUY
  SELL
}

enum PaperOrderType {
  MARKET_LIMIT_SIM
}

enum PaperOrderStatus {
  PENDING
  FILLED
  REJECTED
  CANCELLED
}

enum PaperPositionStatus {
  OPEN
  PARTIAL
  CLOSED
}

enum PaperExitReason {
  STOP_LOSS_HIT
  TAKE_PROFIT_HIT
  INVALIDATION_EXIT
  TIME_EXIT
  AGENT_EXIT
  MANUAL_SIM
}

enum AgentDecisionValidationStatus {
  VALID
  INVALID
  SKIPPED
}

enum PaperAgentAction {
  BUY
  SELL
  HOLD
  EXIT
  REDUCE
  ADD
}

enum ExperimentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BacktestRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PaperAgentClass {
  AI
  HUMAN
}

enum PromptVersionStatus {
  DRAFT
  SHADOW
  CHALLENGER
  ACTIVE
  CHAMPION
  DEPRECATED
}

enum ExperimentType {
  PROMPT_AB
  PARAM_AB
  MODEL_AB
  TEMPERATURE_AB
}

enum ArenaBattleStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum BattleOutcomeVerdict {
  PENDING
  CORRECT_BUY
  WRONG_BUY
  CORRECT_AVOID
  WRONG_AVOID
  CORRECT_RISK
  OPEN
  NEUTRAL
}

enum HallOfFameAchievementType {
  GREATEST_TRADE
  HIGHEST_R_MULTIPLE
  BEST_MONTHLY_RETURN
  LONGEST_WIN_STREAK
  MOST_ACCURATE_AGENT
  BEST_RECOVERY
  HIGHEST_CONFIDENCE_CORRECT
  WORST_PREDICTION
  LUCKIEST_TRADE
  UNLUCKIEST_TRADE
}

enum EvolutionTrend {
  IMPROVING
  STABLE
  DEGRADING
}

model PaperAgent {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String   @map("display_name")
  style       String
  active      Boolean  @default(true)
  configJson  Json     @default("{}") @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions     PaperAgentVersion[]
  portfolio    PaperPortfolio?
  decisions    AgentDecision[]
  performance  AgentPerformanceDaily[]
  rankings     AgentRanking[]
  errors       AgentError[]

  activePromptVersionId String?            @map("active_prompt_version_id") @db.Uuid
  agentClass            PaperAgentClass    @default(AI) @map("agent_class")
  userId                String?            @map("user_id")

  activePromptVersion   PromptVersion?     @relation("ActivePromptVersion", fields: [activePromptVersionId], references: [id], onDelete: SetNull)
  promptVersions        PromptVersion[]    @relation("AgentPromptVersions")
  memoryStats           AgentMemoryStats[]
  setupMemory           AgentSetupMemory[]
  memoryProfiles        AgentMemoryProfile[]
  regimePerformance     AgentRegimePerformanceDaily[]
  calibration           AgentCalibrationDaily[]
  evolution             AgentEvolutionDaily[]
  dnaProfiles           AgentDnaProfile[]
  battleDecisions       ArenaBattleDecision[]
  hofEntries            HallOfFameEntry[]
  experimentPortfolios  ExperimentPortfolio[]

  @@index([active])
  @@index([agentClass])
  @@map("paper_agents")
}

model PaperAgentVersion {
  id            String     @id @default(uuid()) @db.Uuid
  agentId       String     @map("agent_id")
  agent         PaperAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version       String
  promptHash    String     @map("prompt_hash")
  paramsJson    Json       @default("{}") @map("params_json")
  effectiveFrom DateTime   @map("effective_from") @db.Date
  createdAt     DateTime   @default(now()) @map("created_at")

  @@unique([agentId, version])
  @@map("paper_agent_versions")
}

model PaperPortfolio {
  id                 String               @id @default(uuid()) @db.Uuid
  agentId            String               @unique @map("agent_id")
  agent              PaperAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  initialCapitalVnd  BigInt               @default(500000000) @map("initial_capital_vnd")
  cashVnd            BigInt               @default(500000000) @map("cash_vnd")
  status             PaperPortfolioStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  orders    PaperOrder[]
  positions PaperPosition[]
  snapshots PortfolioSnapshot[]
  experimentPortfolio ExperimentPortfolio?

  @@map("paper_portfolios")
}

model PaperOrder {
  id              String           @id @default(uuid()) @db.Uuid
  portfolioId     String           @map("portfolio_id")
  portfolio       PaperPortfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  decisionId      String?          @unique @map("decision_id")
  decision        AgentDecision?   @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  symbol          String
  side            PaperOrderSide
  orderType       PaperOrderType   @default(MARKET_LIMIT_SIM) @map("order_type")
  quantity        Int
  priceKvnd       Float            @map("price_kvnd")
  status          PaperOrderStatus @default(PENDING)
  rejectionReason String?          @map("rejection_reason") @db.Text
  sessionDate     DateTime         @map("session_date") @db.Date
  filledAt        DateTime?        @map("filled_at")
  feesVnd         BigInt           @default(0) @map("fees_vnd")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([portfolioId, sessionDate])
  @@index([symbol, sessionDate])
  @@index([status])
  @@map("paper_orders")
}

model PaperPosition {
  id              String              @id @default(uuid()) @db.Uuid
  portfolioId     String              @map("portfolio_id")
  portfolio       PaperPortfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol          String
  quantity        Int
  avgEntryKvnd    Float               @map("avg_entry_kvnd")
  stopLossKvnd    Float               @map("stop_loss_kvnd")
  takeProfitKvnd  Float               @map("take_profit_kvnd")
  riskAmountVnd   BigInt              @map("risk_amount_vnd")
  status          PaperPositionStatus @default(OPEN)
  openedAt        DateTime            @map("opened_at") @db.Date
  closedAt        DateTime?           @map("closed_at") @db.Date
  entryDecisionId String?             @map("entry_decision_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  trades PaperTrade[]

  @@index([portfolioId, status])
  @@index([symbol, status])
  @@map("paper_positions")
}

model PaperTrade {
  id                String          @id @default(uuid()) @db.Uuid
  positionId        String          @map("position_id")
  position          PaperPosition   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  exitReason        PaperExitReason @map("exit_reason")
  quantity          Int
  entryKvnd         Float           @map("entry_kvnd")
  exitKvnd          Float           @map("exit_kvnd")
  realizedPnlVnd    BigInt          @map("realized_pnl_vnd")
  rMultiple         Float?          @map("r_multiple")
  holdingDays       Int             @map("holding_days")
  closedSessionDate DateTime        @map("closed_session_date") @db.Date
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([positionId])
  @@index([closedSessionDate])
  @@map("paper_trades")
}

model AgentDecision {
  id               String                        @id @default(uuid()) @db.Uuid
  agentId          String                        @map("agent_id")
  agent            PaperAgent                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion     String                        @map("agent_version")
  sessionDate      DateTime                      @map("session_date") @db.Date
  symbol           String
  action           PaperAgentAction
  confidence       Float
  validationStatus AgentDecisionValidationStatus @map("validation_status")
  validationErrors Json?                         @map("validation_errors")
  inputHash        String?                       @map("input_hash")
  experimentRunId  String?                       @map("experiment_run_id")
  experimentRun    ExperimentRun?                @relation(fields: [experimentRunId], references: [id], onDelete: SetNull)
  reasoningSummary String?                       @map("reasoning_summary") @db.Text
  regimeSnapshotSessionDate DateTime?             @map("regime_snapshot_id") @db.Date
  battleId         String?                       @map("battle_id") @db.Uuid
  promptVersionId  String?                       @map("prompt_version_id") @db.Uuid
  memorySnapshotJson Json?                       @map("memory_snapshot_json")
  createdAt        DateTime                      @default(now()) @map("created_at")

  regimeSnapshot MarketRegimeSnapshot? @relation(fields: [regimeSnapshotSessionDate], references: [sessionDate], onDelete: SetNull)
  battle         ArenaBattle?          @relation(fields: [battleId], references: [id], onDelete: SetNull)
  promptVersion  PromptVersion?        @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  explanationTrace ExplanationTrace?
  battleDecision ArenaBattleDecision?

  input  AgentDecisionInput?
  output AgentDecisionOutput?
  order  PaperOrder?

  @@index([sessionDate, agentId])
  @@index([symbol, sessionDate])
  @@index([validationStatus])
  @@map("agent_decisions")
}

