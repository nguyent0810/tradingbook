# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# generated reports (machine-readable audits; regenerate via scripts)
/reports/

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.vercel.local

# local Vercel / ops secrets (never commit)
.secrets/*
!.secrets/vercel.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Fetched market data (regenerate with scripts/fetch_vnindex.py)
/data/vnindex.json
/data/stock-bars.json
/data/stale-fetch-targets.json
/data/fetch-retry-queue.json
/data/stock-bars-shard-*.json
/data/*-shard-*-symbols.json
/data/active-symbol-keys.json
/data/vn-symbols.json

local.env

.vercel

# React Bits — local read-only reference clone (inspiration only, never shipped)
/react-bits

# --- Machine-local npm cache (never commit) ---
/.npm-cache/

# --- Local preview/tooling config (machine-specific) ---
/.claude/launch.json

# --- Temporary run & debug artifacts (recoverable via backup branch; not product) ---
/.tmp-cohort-polish/
/.tmp-cohort-test/
/.tmp-run-*/
/.superpowers/
/docs/temp/
/_anchor-fwd.err
/_anchor-sweep.err
/docs/trading/evidence/_*.log
/docs/trading/evidence/_*.err

# --- Dev-only debug scripts (not product) ---
/scripts/debug-cyber-layout.mjs
/scripts/debug-cyber-opacity.mjs
/scripts/debug-motion.mjs
/scripts/capture-tall.mjs
