# Copy to .env.local for local dev, or set these in your hosting provider's
# environment-variable settings. Never commit real values — this file is
# tracked in git and must only ever contain placeholders.

# ── Core app (required to run anything) ──────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/trading?schema=public"
SESSION_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_SITE_URL="https://your-deployed-domain.example"

# ── TikTok Content Posting API demo (src/lib/tiktok/*, /tiktok-demo) ─────
# See docs/integration/TIKTOK_CONTENT_POSTING_DEMO.md for full setup steps
# and docs/integration/TIKTOK_API_AUDIT.md for what has/hasn't been verified.

# From the TikTok Developer Portal app's Login Kit config. Required.
TIKTOK_CLIENT_KEY=""

# From the same app config. Required. Server-side only — never exposed to
# the client, never logged. Keep this out of any client-visible env var.
TIKTOK_CLIENT_SECRET=""

# Must exactly match a Redirect URI registered in the portal: https only,
# no query string, no #fragment, on a domain you've completed TikTok's
# domain verification for. Required.
# e.g. "https://your-deployed-domain.example/api/tiktok/oauth/callback"
TIKTOK_REDIRECT_URI=""

# Optional. Set to "true" to additionally request the video.publish scope
# and enable Direct Post in the demo UI. Leave unset/"false" to stay on the
# default Inbox/Draft-only flow (video.upload scope only — the minimum
# required, and the simplest path for an unaudited app's first sandbox
# validation).
TIKTOK_ENABLE_DIRECT_POST="false"

# Optional but recommended. Signs the httpOnly cookie that holds TikTok's
# tokens (kept separate from this app's own SESSION_SECRET/session cookie).
# Falls back to SESSION_SECRET, then an insecure dev default, if unset —
# do not rely on the fallback in any shared/deployed environment.
TIKTOK_SESSION_SECRET="replace-with-a-different-long-random-string"

# ── Optional (only if the corresponding feature is in use) ───────────────
CRON_SECRET=""
EARLY_ENTRY_V1_ENABLED=""
